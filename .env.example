# Копировать в .env, который не коммитится.
DB_PASSWORD=devonly

# Обязательна: приложение падает на старте, если не задана.
# Сгенерировать: openssl rand -base64 48
JWT_SECRET=

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Первый администратор: задать на первый запуск, затем убрать и сменить
# пароль через POST /api/v1/me/password. Если активный ADMIN уже есть,
# эти переменные игнорируются.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=
